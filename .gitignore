# Local config (holds API keys) — never commit it in any form.
# ReconX auto-generates a fresh config.yaml on first run if missing.
config.yaml

# ReconX runtime output & scratch
output/
results/
__pycache__/
*.pyc
*.log
install.log
pipeline.log

# Local tooling / clones
trufflehog/
.venv/
venv/

# v8.8: ReconX'in kendi yonettigi izole Tor sureci — torrc, control password,
# veri/log dizini (auto_tor rotasyon ozelligi). Hicbir zaman commit edilmemeli.
.tor_data/

# Per-engagement artefacts (keep these out of the repo)
request.txt
*.oast.*
/targets*.txt
/-

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local-only tooling and clones. Not part of the scanner.
node_modules/
.playwright-mcp/
claude-usage/
package.json
package-lock.json
